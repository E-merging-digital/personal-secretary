#!/usr/bin/env bash
set -euo pipefail

MODE="${1:-development}"
case "${MODE}" in
  development|production) ;;
  *)
    echo "Usage: $0 [development|production]" >&2
    exit 64
    ;;
esac

export PERSONAL_SECRETARY_ENV="${MODE}"
DRUSH="${DRUSH:-vendor/bin/drush}"

"${DRUSH}" sql:drop -y || true
"${DRUSH}" site:install --existing-config -y \
  --account-name=admin \
  --account-pass=synthetic-ci-admin

# Re-apply the canonical repository source after the installer has completed
# extension installation and environment-specific Config Split transforms.
"${DRUSH}" config:import -y
"${DRUSH}" cache:rebuild

"$(dirname "$0")/verify" "${MODE}"
