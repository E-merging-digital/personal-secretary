#!/usr/bin/env bash
set -euo pipefail

MODE="${1:-development}"
case "${MODE}" in
  development|production) ;;
  *)
    echo "Usage: $0 [development|production]" >&2
    exit 64
    ;;
esac

export PERSONAL_SECRETARY_ENV="${MODE}"
DRUSH="${DRUSH:-vendor/bin/drush}"

mkdir -p config/sync config/splits/development

if "${DRUSH}" status --field=bootstrap 2>/dev/null | grep -q '^Successful$'; then
  "${DRUSH}" sql:drop -y
fi

"${DRUSH}" site:install minimal -y --site-name="Personal Secretary" --account-name="admin" --account-pass="synthetic-ci-admin"

"${DRUSH}" pm:install navigation gin_toolbar pathauto token config_split -y
"${DRUSH}" theme:enable gin -y
"${DRUSH}" config:set system.theme admin gin -y

if [[ "${MODE}" == "development" ]]; then
  "$(dirname "$0")/configure-development-split"
fi

"${DRUSH}" cache:rebuild
