/**
 * Ensures the bilingual runtime prerequisites on a clean installation.
 */
function personal_secretary_install(): void {
  // On a clean installation, the language entities are owned by canonical
  // configuration import. Do not create them from hook_install(), because that
  // would race their repository UUIDs during --existing-config installation.
  personal_secretary_import_french_catalog();
}

/**
 * Enables the bilingual runtime and imports project French translations.
 */
function personal_secretary_update_11008(): string {
  personal_secretary_ensure_bilingual_runtime();
  $report = personal_secretary_import_french_catalog();

  return sprintf(
    'Enabled Drupal Core French/English runtime support and imported the project French catalog (%d additions, %d updates, %d skips).',
    (int) ($report['additions'] ?? 0),
    (int) ($report['updates'] ?? 0),
    (int) ($report['skips'] ?? 0),
  );
}

