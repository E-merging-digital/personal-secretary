/**
 * Restores product-theme block placement on existing sites.
 */
function personal_secretary_update_11010(): string {
  $themeName = 'personal_secretary_product';
  $theme = \Drupal::service('theme_handler')->getTheme($themeName);

  if (!$theme->status) {
    throw new RuntimeException(
      'The Personal Secretary product theme must be installed before update 11010.',
    );
  }

  $targets = [
    'personal_secretary_product_content' => [
      'plugin' => 'system_main_block',
      'region' => 'content',
    ],
    'personal_secretary_product_messages' => [
      'plugin' => 'system_messages_block',
      'region' => 'highlighted',
    ],
    'personal_secretary_product_page_title' => [
      'plugin' => 'page_title_block',
      'region' => 'content',
    ],
    'personal_secretary_product_shell' => [
      'plugin' => 'personal_secretary_product_shell',
      'region' => 'header',
    ],
  ];

  $storage = \Drupal::entityTypeManager()->getStorage('block');
  $blocks = [];

  // Validate every invariant before mutating any block.
  foreach ($targets as $id => $expected) {
    /** @var \Drupal\block\BlockInterface|null $block */
    $block = $storage->load($id);

    if ($block === NULL) {
      throw new RuntimeException(
        sprintf('Required product-theme block "%s" does not exist.', $id),
      );
    }
    if ($block->getTheme() !== $themeName) {
      throw new RuntimeException(
        sprintf(
          'Product-theme block "%s" has unexpected theme "%s".',
          $id,
          $block->getTheme(),
        ),
      );
    }
    if ($block->getPluginId() !== $expected['plugin']) {
      throw new RuntimeException(
        sprintf(
          'Product-theme block "%s" has unexpected plugin "%s".',
          $id,
          $block->getPluginId(),
        ),
      );
    }

    $blocks[$id] = $block;
  }

  foreach ($blocks as $id => $block) {
    $block
      ->setRegion($targets[$id]['region'])
      ->enable()
      ->save();
  }

  return 'Restored Personal Secretary product-theme block placement on existing installs.';
}

/**
 * Installs manual Google event mappings without exporting or backfilling data.
 */
function personal_secretary_update_11011(): string {
  $updateManager = \Drupal::entityDefinitionUpdateManager();
  if ($updateManager->getEntityType('personal_sec_google_projection') !== NULL) {
    return 'The Google Calendar projection entity type is already installed.';
  }
  // Frozen definition: no live entity/field discovery on skipped-version updates.
  $entityType = new ContentEntityType([
    'id' => 'personal_sec_google_projection',
    'class' => \Drupal\personal_secretary\Entity\GoogleCalendarProjection::class,
    'provider' => 'personal_secretary',
    'label' => new TranslatableMarkup('Google Calendar projection'),
    'entity_keys' => ['id' => 'id', 'uuid' => 'uuid'],
    'handlers' => [
      'access' => DomainEntityAccessControlHandler::class,
      'storage_schema' => \Drupal\personal_secretary\Storage\GoogleCalendarProjectionStorageSchema::class,
    ],
    'admin_permission' => 'administer personal secretary domain',
    'base_table' => 'personal_sec_google_projection',
  ]);
  $fields = [];
  $fields['id'] = BaseFieldDefinition::create('integer')
    ->setLabel(new TranslatableMarkup('ID'))->setReadOnly(TRUE)->setSetting('unsigned', TRUE);
  $fields['uuid'] = BaseFieldDefinition::create('uuid')
    ->setLabel(new TranslatableMarkup('UUID'))->setReadOnly(TRUE);
  $fields['owner_user'] = BaseFieldDefinition::create('entity_reference')
    ->setLabel(new TranslatableMarkup('Owner User'))
    ->setRequired(TRUE)->setSetting('target_type', 'user');
  foreach ([
    'provider' => 16,
    'target' => 16,
    'series_uuid' => 128,
    'original_occurrence_key' => 32,
    'identity_hash' => 64,
    'provider_subject_id' => 255,
    'event_id' => 66,
    'etag' => 255,
    'provider_link' => 2048,
    'payload_fingerprint' => 64,
    'state' => 16,
  ] as $name => $length) {
    $fields[$name] = BaseFieldDefinition::create('string')
      ->setLabel(new TranslatableMarkup('@name', ['@name' => $name]))
      ->setRequired(TRUE)->setSetting('max_length', $length);
  }
  $fields['created_at'] = BaseFieldDefinition::create('created')->setRequired(TRUE);
  $fields['updated_at'] = BaseFieldDefinition::create('changed')->setRequired(TRUE);
  $updateManager->installFieldableEntityType($entityType, $fields);
  return 'Installed Google Calendar projection with zero backfill.';
}

/**
 * Uses Drupal Core modules and language entities only.
 */
function personal_secretary_ensure_bilingual_runtime(): void {
  $installer = \Drupal::service('module_installer');
  $installer->install(['language', 'locale']);

  $storage = \Drupal::entityTypeManager()->getStorage('configurable_language');
  foreach (['en', 'fr'] as $langcode) {
    if ($storage->load($langcode) === NULL) {
      ConfigurableLanguage::createFromLangcode($langcode)->save();
    }
  }
}

/**
 * Imports the repository-owned French catalog without network access.
 */
function personal_secretary_import_french_catalog(): array {
  if (!\Drupal::moduleHandler()->moduleExists('locale')) {
    return ['additions' => 0, 'updates' => 0, 'deletes' => 0, 'skips' => 0];
  }

  $path = __DIR__ . '/translations/fr.po';
  if (!is_file($path)) {
    throw new RuntimeException('The Personal Secretary French translation catalog is missing.');
  }

  $report = Gettext::fileToDatabase(
    (object) [
      'langcode' => 'fr',
      'uri' => $path,
    ],
    [
      'overwrite_options' => [
        'not_customized' => TRUE,
        'customized' => FALSE,
      ],
      'customized' => 0,
    ],
  );

  \Drupal::service('string_translation')->reset();
  return $report;
}

/**
 * Installs external planning shadows and sync state with zero backfill.
 */
function personal_secretary_update_11012(): string {
  $updateManager = \Drupal::entityDefinitionUpdateManager();
  $installed = [];

  if ($updateManager->getEntityType('personal_sec_ext_event_shadow') === NULL) {
    $entityType = new ContentEntityType([
      'id' => 'personal_sec_ext_event_shadow',
      'class' => \Drupal\personal_secretary\Entity\ExternalEventShadow::class,
      'provider' => 'personal_secretary',
      'label' => new TranslatableMarkup('External event shadow'),
      'label_singular' => new TranslatableMarkup('external event shadow'),
      'label_plural' => new TranslatableMarkup('external event shadows'),
      'entity_keys' => [
        'id' => 'id',
        'uuid' => 'uuid',
        'label' => 'title',
      ],
      'handlers' => [
        'access' => DomainEntityAccessControlHandler::class,
        'storage_schema' => \Drupal\personal_secretary\Storage\ExternalEventShadowStorageSchema::class,
      ],
      'admin_permission' => 'administer personal secretary domain',
      'base_table' => 'personal_sec_ext_event_shadow',
    ]);

    $fields = [];
    $fields['id'] = BaseFieldDefinition::create('integer')
      ->setLabel(new TranslatableMarkup('ID'))
      ->setReadOnly(TRUE)
      ->setSetting('unsigned', TRUE);
    $fields['uuid'] = BaseFieldDefinition::create('uuid')
      ->setLabel(new TranslatableMarkup('UUID'))
      ->setReadOnly(TRUE);
    $fields['owner_user'] = BaseFieldDefinition::create('entity_reference')
      ->setLabel(new TranslatableMarkup('Owner User'))
      ->setRequired(TRUE)
      ->setSetting('target_type', 'user');
    $fields['account_connection'] = BaseFieldDefinition::create('entity_reference')
      ->setLabel(new TranslatableMarkup('Calendar account connection'))
      ->setRequired(TRUE)
      ->setSetting('target_type', 'personal_sec_calendar_connection');
    foreach ([
      'provider' => 32,
      'calendar_id' => 255,
      'provider_event_id' => 1024,
      'identity_hash' => 64,
      'etag' => 255,
      'provider_status' => 32,
      'title' => 255,
      'time_mode' => 16,
      'source_timezone' => 64,
      'location' => 255,
      'transparency' => 16,
      'recurring_event_id' => 1024,
      'original_start_time' => 255,
      'original_start_timezone' => 64,
    ] as $name => $length) {
      $fields[$name] = BaseFieldDefinition::create('string')
        ->setLabel(new TranslatableMarkup('@name', ['@name' => $name]))
        ->setSetting('max_length', $length);
    }
    foreach (['timed_start', 'timed_end', 'provider_updated'] as $name) {
      $fields[$name] = BaseFieldDefinition::create('datetime')
        ->setLabel(new TranslatableMarkup('@name', ['@name' => $name]))
        ->setSetting('datetime_type', 'datetime');
    }
    foreach (['all_day_start', 'all_day_end'] as $name) {
      $fields[$name] = BaseFieldDefinition::create('datetime')
        ->setLabel(new TranslatableMarkup('@name', ['@name' => $name]))
        ->setSetting('datetime_type', 'date');
    }
    $fields['active'] = BaseFieldDefinition::create('boolean')
      ->setLabel(new TranslatableMarkup('Active planning item'))
      ->setRequired(TRUE)
      ->setDefaultValue(TRUE);
    $fields['last_seen_at'] = BaseFieldDefinition::create('timestamp')
      ->setLabel(new TranslatableMarkup('Last seen at'))
      ->setRequired(TRUE);
    $fields['created_at'] = BaseFieldDefinition::create('created')->setRequired(TRUE);
    $fields['changed_at'] = BaseFieldDefinition::create('changed')->setRequired(TRUE);

    $updateManager->installFieldableEntityType($entityType, $fields);
    $installed[] = 'external planning shadows';
  }

  if ($updateManager->getEntityType('personal_sec_calendar_sync_state') === NULL) {
    $entityType = new ContentEntityType([
      'id' => 'personal_sec_calendar_sync_state',
      'class' => \Drupal\personal_secretary\Entity\CalendarSyncState::class,
      'provider' => 'personal_secretary',
      'label' => new TranslatableMarkup('Calendar sync state'),
      'label_singular' => new TranslatableMarkup('calendar sync state'),
      'label_plural' => new TranslatableMarkup('calendar sync states'),
      'entity_keys' => [
        'id' => 'id',
        'uuid' => 'uuid',
      ],
      'handlers' => [
        'access' => DomainEntityAccessControlHandler::class,
        'storage_schema' => \Drupal\personal_secretary\Storage\CalendarSyncStateStorageSchema::class,
      ],
      'admin_permission' => 'administer personal secretary domain',
      'base_table' => 'personal_sec_calendar_sync_state',
    ]);

    $fields = [];
    $fields['id'] = BaseFieldDefinition::create('integer')
      ->setLabel(new TranslatableMarkup('ID'))
      ->setReadOnly(TRUE)
      ->setSetting('unsigned', TRUE);
    $fields['uuid'] = BaseFieldDefinition::create('uuid')
      ->setLabel(new TranslatableMarkup('UUID'))
      ->setReadOnly(TRUE);
    $fields['owner_user'] = BaseFieldDefinition::create('entity_reference')
      ->setLabel(new TranslatableMarkup('Owner User'))
      ->setRequired(TRUE)
      ->setSetting('target_type', 'user');
    $fields['account_connection'] = BaseFieldDefinition::create('entity_reference')
      ->setLabel(new TranslatableMarkup('Calendar account connection'))
      ->setRequired(TRUE)
      ->setSetting('target_type', 'personal_sec_calendar_connection');
    foreach ([
      'provider' => 32,
      'calendar_id' => 255,
      'identity_hash' => 64,
      'sync_token' => 2048,
      'status' => 32,
      'last_mode' => 16,
      'last_error_class' => 64,
      'last_rebase_date' => 10,
    ] as $name => $length) {
      $fields[$name] = BaseFieldDefinition::create('string')
        ->setLabel(new TranslatableMarkup('@name', ['@name' => $name]))
        ->setSetting('max_length', $length);
    }
    foreach ([
      'cursor_generation',
      'provider_item_count',
      'shadow_create_count',
      'shadow_update_count',
      'shadow_delete_count',
      'linked_deduplicated_count',
    ] as $name) {
      $fields[$name] = BaseFieldDefinition::create('integer')
        ->setLabel(new TranslatableMarkup('@name', ['@name' => $name]))
        ->setDefaultValue(0);
    }
    foreach (['last_attempt_at', 'last_success_at'] as $name) {
      $fields[$name] = BaseFieldDefinition::create('timestamp')
        ->setLabel(new TranslatableMarkup('@name', ['@name' => $name]));
    }
    $fields['created_at'] = BaseFieldDefinition::create('created')->setRequired(TRUE);
    $fields['changed_at'] = BaseFieldDefinition::create('changed')->setRequired(TRUE);

    $updateManager->installFieldableEntityType($entityType, $fields);
    $installed[] = 'calendar sync state';
  }

  return $installed === []
    ? 'External planning persistence is already installed.'
    : 'Installed ' . implode(' and ', $installed) . ' with zero backfill.';
}

/**
 * Re-imports the repository-owned French catalog on existing sites.
 */
function personal_secretary_update_11013(): string {
  $report = personal_secretary_import_french_catalog();

  return sprintf(
    'Re-imported the project French catalog for existing installations (%d additions, %d updates, %d skips).',
    (int) ($report['additions'] ?? 0),
    (int) ($report['updates'] ?? 0),
    (int) ($report['skips'] ?? 0),
  );
}
