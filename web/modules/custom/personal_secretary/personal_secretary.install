  $updateManager->installFieldStorageDefinition(
    'concerned_persons',
    'personal_sec_activity_series',
    'personal_secretary',
    $field,
  );

  return 'Installed the optional ActivitySeries concerned-person field with zero inference or backfill.';
}

/**
 * Installs the revisionable ActivitySeries temporal mode field.
 */
function personal_secretary_update_11006(): string {
  $updateManager = \Drupal::entityDefinitionUpdateManager();
  if ($updateManager->getFieldStorageDefinition('time_mode', 'personal_sec_activity_series') !== NULL) {
    return 'The ActivitySeries time-mode field is already installed.';
  }

  $field = BaseFieldDefinition::create('string')
    ->setLabel(new TranslatableMarkup('Time mode'))
    ->setRequired(TRUE)
    ->setRevisionable(TRUE)
    ->setDefaultValue(ActivitySeries::TIME_MODE_TIMED)
    ->setSetting('max_length', 16);

  $updateManager->installFieldStorageDefinition(
    'time_mode',
    'personal_sec_activity_series',
    'personal_secretary',
    $field,
  );

  return 'Installed the ActivitySeries time-mode field with deterministic TIMED legacy default and zero timestamp inference.';
}

