<?php

declare(strict_types=1);

/**
 * Implements hook_page_attachments().
 */
function personal_secretary_page_attachments(array &$attachments): void {
  $base_path = base_path();

  $attachments['#attached']['html_head_link'][] = [
    [
      'rel' => 'manifest',
      'href' => $base_path . 'personal-secretary.webmanifest',
    ],
    TRUE,
  ];
  $attachments['#attached']['html_head_link'][] = [
    [
      'rel' => 'apple-touch-icon',
      'href' => $base_path . 'pwa-icon-192.png',
      'sizes' => '192x192',
    ],
    TRUE,
  ];
  $attachments['#attached']['html_head'][] = [
    [
      '#tag' => 'meta',
      '#attributes' => [
        'name' => 'theme-color',
        'content' => '#1b9ae4',
      ],
    ],
    'personal_secretary_theme_color',
  ];
  $attachments['#attached']['library'][] = 'personal_secretary/pwa';
}

/**
 * Implements hook_cron().
 */
function personal_secretary_cron(): void {
  \Drupal\personal_secretary\Service\PreparationReminderDeliveryService::create(\Drupal::getContainer())->enqueueDueReminders();
}

/**
 * Implements hook_mail().
 */
function personal_secretary_mail(string $key, array &$message, array $params): void {
  if ($key !== 'preparation_reminder') {
    return;
  }
  $message['subject'] = 'Personal Secretary — préparation à effectuer';
  $message['body'][] = 'Vous avez une préparation à effectuer dans Personal Secretary.';
  $message['body'][] = (string) ($params['preparations_url'] ?? '/personal-secretary/preparations/mine');
}
