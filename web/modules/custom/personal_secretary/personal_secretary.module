<?php

declare(strict_types=1);

use Drupal\Core\Datetime\TimeZoneFormHelper;
use Drupal\Core\Form\FormStateInterface;
use Drupal\user\UserInterface;

/**
 * Implements hook_form_FORM_ID_alter() for the Drupal User account form.
 */
function personal_secretary_form_user_form_alter(array &$form, FormStateInterface $form_state): void {
  $formObject = $form_state->getFormObject();
  if (!method_exists($formObject, 'getEntity')) {
    return;
  }

  $account = $formObject->getEntity();
  $currentUser = Drupal::currentUser();
  if (
    !$account instanceof UserInterface
    || $currentUser->isAnonymous()
    || (int) $account->id() !== (int) $currentUser->id()
    || !isset($form['timezone']['timezone'])
    || !Drupal::config('system.date')->get('timezone.user.configurable')
  ) {
    return;
  }

  $persisted = trim((string) $account->getTimezone());
  if ($persisted !== '' && isset(TimeZoneFormHelper::getOptionsList()[$persisted])) {
    return;
  }

  // Core's account form correctly owns persistence, but its historical
  // drupal.timezone behavior may fall back to an XHR. Replace only that
  // detection layer with the project's network-free Intl suggestion.
  if (isset($form['timezone']['#attached']['library'])) {
    $form['timezone']['#attached']['library'] = array_values(array_filter(
      $form['timezone']['#attached']['library'],
      static fn(string $library): bool => $library !== 'core/drupal.timezone',
    ));
  }
  $form['timezone']['#attached']['library'][] = 'personal_secretary/timezone_detection';

  $classes = $form['timezone']['timezone']['#attributes']['class'] ?? [];
  $classes = array_values(array_filter(
    $classes,
    static fn(string $class): bool => $class !== 'timezone-detect',
  ));
  $classes[] = 'personal-secretary-timezone-detect';
  $form['timezone']['timezone']['#attributes']['class'] = array_values(array_unique($classes));

  /** @var \Drupal\personal_secretary\Service\CurrentUserTimezoneService $timezone */
  $timezone = Drupal::service('personal_secretary.current_user_timezone');
  $form['timezone']['timezone']['#default_value'] = $timezone->effectiveTimezone();
}

/**
 * Implements hook_page_attachments().
 */
function personal_secretary_page_attachments(array &$attachments): void {
  $base_path = base_path();

  // iOS uses this public project-owned branding asset for Add to Home Screen.
  $attachments['#attached']['html_head_link'][] = [
    [
      'rel' => 'apple-touch-icon',
      'href' => $base_path . 'pwa-icon-192.png',
      'sizes' => '192x192',
    ],
    TRUE,
  ];

  // The privacy-safe worker remains project-owned; the contrib SW stays off.
  $attachments['#attached']['library'][] = 'personal_secretary/pwa';
}

/**
 * Implements hook_pwa_manifest_alter().
 */
function personal_secretary_pwa_manifest_alter(array &$manifest_data): void {
  $base_path = base_path();
  $manifest_data['icons'] = [
    [
      'src' => $base_path . 'pwa-icon-512.png',
      'sizes' => '512x512',
      'type' => 'image/png',
      'purpose' => 'any',
    ],
    [
      'src' => $base_path . 'pwa-icon-192.png',
      'sizes' => '192x192',
      'type' => 'image/png',
      'purpose' => 'any',
    ],
  ];
}

/**
 * Implements hook_cron().
 */
function personal_secretary_cron(): void {
  \Drupal\personal_secretary\Service\PreparationReminderDeliveryService::create(\Drupal::getContainer())->enqueueDueReminders();
}

/**
 * Implements hook_mail().
 */
function personal_secretary_mail(string $key, array &$message, array $params): void {
  if ($key !== 'preparation_reminder') {
    return;
  }
  $message['subject'] = 'Personal Secretary — préparation à effectuer';
  $message['body'][] = 'Vous avez une préparation à effectuer dans Personal Secretary.';
  $message['body'][] = (string) ($params['preparations_url'] ?? '/personal-secretary/preparations/mine');
}

/**
 * Implements hook_mail_backend_info_alter().
 */
function personal_secretary_mail_backend_info_alter(array &$info): void {
  if (isset($info['phpmailer_smtp'])) {
    $info['phpmailer_smtp']['class'] = \Drupal\personal_secretary\Mail\PrivacySafePhpMailerSmtp::class;
  }
}
