<article class="personal-secretary-external-event" data-planning-source="external">
  <header class="personal-secretary-external-event__header">
    <h3>{{ title ?: 'Untitled calendar event'|t }}</h3>
    <span class="personal-secretary-external-event__source">{{ source_label|t }}</span>
  </header>
  <dl>
    <div>
      <dt>{{ 'When'|t }}</dt>
      <dd>
        {% if all_day %}
          {{ 'All day'|t }} —
          {% if all_day_start_date == all_day_end_date %}
            <time datetime="{{ all_day_start_date }}">{{ display_start_label }}</time>
          {% else %}
            {{ 'from'|t }} <time datetime="{{ all_day_start_date }}">{{ display_start_label }}</time>
            {{ 'to'|t }} <time datetime="{{ all_day_end_date }}">{{ display_end_label }}</time>
          {% endif %}
        {% else %}
          <time datetime="{{ effective_start_iso }}">{{ display_start_label }}</time>
          –
          <time datetime="{{ effective_end_iso }}">{{ display_end_label }}</time>
          ({{ display_timezone }})
        {% endif %}
      </dd>
    </div>
    {% if location %}
      <div>
        <dt>{{ 'Location'|t }}</dt>
        <dd>{{ location }}</dd>
      </div>
    {% endif %}
    <div>
      <dt>{{ 'Planning impact'|t }}</dt>
      <dd>
        {% if busy_impact == 'INFORMATIONAL' %}
          {{ 'Informational'|t }}
        {% elseif busy_impact == 'TENTATIVE_BUSY' %}
          {{ 'Tentative'|t }}
        {% else %}
          {{ 'Busy'|t }}
        {% endif %}
      </dd>
    </div>
  </dl>
  <p class="personal-secretary-external-event__readonly">{{ 'Read-only external event'|t }}</p>
</article>
