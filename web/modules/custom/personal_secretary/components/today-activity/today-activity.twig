<article class="personal-secretary-today-activity">
  <h3>
    {% if detail_url %}
      <a class="ps-today-activity__title" href="{{ detail_url }}">{{ activity_label }}</a>
    {% else %}
      {{ activity_label }}
    {% endif %}
  </h3>
  <dl>
    <div>
      <dt>{{ 'When'|t }}</dt>
      <dd>
        {% if all_day %}
          {{ 'All day'|t }} —
          {% if all_day_start_date == all_day_end_date %}
            <time datetime="{{ all_day_start_date }}">{{ display_start_label }}</time>
          {% else %}
            {{ 'from'|t }} <time datetime="{{ all_day_start_date }}">{{ display_start_label }}</time>
            {{ 'to'|t }} <time datetime="{{ all_day_end_date }}">{{ display_end_label }}</time>
          {% endif %}
          ({{ source_timezone }})
        {% else %}
          <time datetime="{{ effective_start_iso }}">{{ display_start_label }}</time>
          –
          <time datetime="{{ effective_end_iso }}">{{ display_end_label }}</time>
          ({{ display_timezone }})
        {% endif %}
      </dd>
    </div>
    {% if location %}
      <div>
        <dt>{{ 'Location'|t }}</dt>
        <dd>{{ location }}</dd>
      </div>
    {% endif %}
    {% if concerned_person_labels %}
      <div>
        <dt>{{ 'For'|t }}</dt>
        <dd>{{ concerned_person_labels|join(', ') }}</dd>
      </div>
    {% endif %}
  </dl>
</article>
