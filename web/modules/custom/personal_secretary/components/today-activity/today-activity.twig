<article class="personal-secretary-today-activity">
  <h3>{{ activity_label }}</h3>
  <dl>
    <div>
      <dt>{{ 'When'|t }}</dt>
      <dd>
        {% if all_day %}
          {{ 'All day'|t }} —
          {% if all_day_start_date == all_day_end_date %}
            <time datetime="{{ all_day_start_date }}">{{ all_day_start_date }}</time>
          {% else %}
            {{ 'from'|t }} <time datetime="{{ all_day_start_date }}">{{ all_day_start_date }}</time>
            {{ 'to'|t }} <time datetime="{{ all_day_end_date }}">{{ all_day_end_date }}</time>
          {% endif %}
          ({{ source_timezone }})
        {% else %}
          <time datetime="{{ effective_start_iso }}">{{ effective_start }}</time>
          –
          <time datetime="{{ effective_end_iso }}">{{ effective_end }}</time>
          ({{ display_timezone }})
        {% endif %}
      </dd>
    </div>
    {% if location %}
      <div>
        <dt>{{ 'Location'|t }}</dt>
        <dd>{{ location }}</dd>
      </div>
    {% endif %}
    {% if concerned_person_labels %}
      <div>
        <dt>{{ 'For'|t }}</dt>
        <dd>{{ concerned_person_labels|join(', ') }}</dd>
      </div>
    {% endif %}
  </dl>
</article>
