<article class="personal-secretary-upcoming-activity">
  <h2>{{ activity_label }}</h2>

  <dl>
    <div>
      <dt>{{ 'When'|t }}</dt>
      <dd>
        {% if all_day %}
          {{ 'Toute la journée'|t }} —
          {% if all_day_start_date == all_day_end_date %}
            <time datetime="{{ all_day_start_date }}">{{ all_day_start_date }}</time>
          {% else %}
            {{ 'du'|t }} <time datetime="{{ all_day_start_date }}">{{ all_day_start_date }}</time>
            {{ 'au'|t }} <time datetime="{{ all_day_end_date }}">{{ all_day_end_date }}</time>
          {% endif %}
          ({{ source_timezone }})
        {% else %}
          <time datetime="{{ effective_start_iso }}">{{ effective_start }}</time>
          –
          <time datetime="{{ effective_end_iso }}">{{ effective_end }}</time>
          ({{ source_timezone }})
        {% endif %}
      </dd>
    </div>
    {% if location %}
      <div>
        <dt>{{ 'Location'|t }}</dt>
        <dd>{{ location }}</dd>
      </div>
    {% endif %}
    {% if concerned_person_labels %}
      <div>
        <dt>{{ 'Pour'|t }}</dt>
        <dd>{{ concerned_person_labels|join(', ') }}</dd>
      </div>
    {% endif %}
    <div>
      <dt>{{ 'Responsibility'|t }}</dt>
      <dd>{{ responsibility_label }}</dd>
    </div>
  </dl>

  {% if preparations %}
    <h3>{{ 'To prepare'|t }}</h3>
    <ul>
      {% for preparation in preparations %}
        <li>
          {{ preparation.instruction }} —
          {{ 'due'|t }}
          <time datetime="{{ preparation.due_time_iso }}">{{ preparation.due_time }}</time>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</article>
