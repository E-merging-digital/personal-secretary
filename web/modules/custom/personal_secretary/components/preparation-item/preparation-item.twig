<article class="personal-secretary-preparation-item">
  <h3>{{ instruction }}</h3>
  <dl>
    <div>
      <dt>{{ 'Due'|t }}</dt>
      <dd>
        <time datetime="{{ due_time_iso }}">{{ due_time }}</time>
        ({{ display_timezone }})
        {% if overdue %}<strong>{{ 'Overdue'|t }}</strong>{% endif %}
      </dd>
    </div>
    <div>
      <dt>{{ 'Activity'|t }}</dt>
      <dd>
        {{ activity_label }} —
        <time datetime="{{ activity_start_iso }}">{{ activity_start }}</time>
      </dd>
    </div>
  </dl>
</article>
